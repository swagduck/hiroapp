generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String?
  phone     String?
  name      String?
  dob       String?
  customerCode String?
  role      Role     @default(CUSTOMER)
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  savedMinutes Int @default(0)
  
  // Member Perks
  points        Int @default(0)
  freeDrinkTokens Int @default(0)
  lastBirthdayClaimYear Int?
  tokenVersion  Int @default(0)

  sessions  Session[]
  orders    Order[]
  cashTransactions CashTransaction[]
  shiftRecords ShiftRecord[]

  @@index([phone])
  @@index([role])
}

enum PackageType {
  HOURLY
  DAILY
  FIXED
}

model Package {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  type        PackageType @default(HOURLY)
  duration    Int?     // Duration in minutes (if applicable)
  includesDrink Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Quan hệ
  sessions    Session[]

  @@index([isActive])
  @@index([price])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Voucher {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  code          String       @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float        // e.g. 20 (for 20%) or 15000 (for 15k)
  maxDiscount   Float?       // Optional max discount amount for percentage type
  minOrderValue Float?       // Minimum order value to apply
  validFrom     DateTime?
  validUntil    DateTime?
  isActive      Boolean      @default(true)
  usageLimit    Int?         // Total number of times this voucher can be used
  usedCount     Int          @default(0)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]
  sessions      Session[]
}

enum SessionStatus {
  PENDING_PAYMENT
  PRE_BOOKED
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Session {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])
  packageId   String   @db.ObjectId
  package     Package  @relation(fields: [packageId], references: [id])
  
  startTime   DateTime @default(now())
  endTime     DateTime?
  status      SessionStatus @default(ACTIVE)
  paymentStatus PaymentStatus @default(PAID) // Default PAID for backward compatibility with POS
  totalAmount Float?   // Store total amount required to pay
  
  accessCode  String   @unique // Access code for Wi-Fi / tracking
  transId     String?  // Mã giao dịch (vd: dùng cho ZaloPay app_trans_id)
  freeDrinkClaimed Boolean @default(false) // Trạng thái đã lấy ly nước miễn phí chưa (nếu gói là combo)
  savedMinutesUsed Int? // Số phút bảo lưu được dùng cho phiên này (nếu có)
  extraMinutes Int @default(0) // Số phút được gia hạn thêm
  
  // Voucher info
  voucherId   String?  @db.ObjectId
  voucher     Voucher? @relation(fields: [voucherId], references: [id])
  discountAmount Float? @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([status])
  @@index([startTime])
  @@index([packageId])
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  items       MenuItem[]
}

model MenuItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean  @default(true)
  categoryId  String?  @db.ObjectId
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
  recipeItems RecipeItem[]

  @@index([isAvailable])
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  CANCELLED
}

model Order {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String?  @db.ObjectId
  session     Session? @relation(fields: [sessionId], references: [id])
  userId      String?  @db.ObjectId // Optional, if they order outside a session
  user        User?    @relation(fields: [userId], references: [id])
  
  status      OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  totalAmount Float
  transId     String?
  
  // Voucher info
  voucherId   String?  @db.ObjectId
  voucher     Voucher? @relation(fields: [voucherId], references: [id])
  discountAmount Float? @default(0)

  items       OrderItem[]
  
  // Extension Fields
  isExtension Boolean @default(false)
  extensionPackageId String? @db.ObjectId
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isExtension])
  @@index([createdAt])
  @@index([sessionId])
}

model OrderItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String   @db.ObjectId
  order       Order    @relation(fields: [orderId], references: [id])
  menuItemId  String   @db.ObjectId
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  quantity    Int      @default(1)
  price       Float    // Price at the time of order
}

model ArchivedRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  collection  String   // "Session" or "Order"
  originalId  String
  data        Json
  archivedAt  DateTime @default(now())

  @@index([collection])
  @@index([originalId])
  @@index([archivedAt])
}

// INVENTORY MANAGEMENT

model Ingredient {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  unit          String   // e.g., 'g', 'ml', 'cái'
  currentStock  Float    @default(0)
  minStock      Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipeItems   RecipeItem[]
  transactions  InventoryTransaction[]

  @@index([isActive])
}

model RecipeItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  menuItemId    String   @db.ObjectId
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  ingredientId  String   @db.ObjectId
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  quantity      Float    // Amount of ingredient required per 1 menuItem
  
  @@unique([menuItemId, ingredientId])
}

enum TransactionType {
  RESTOCK
  CONSUMED
  ADJUSTED
}

model InventoryTransaction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  ingredientId  String   @db.ObjectId
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  type          TransactionType
  amountChanged Float    // Positive for RESTOCK, Negative for CONSUMED
  reason        String?  // e.g. "Order #1234", "Nhập hàng tuần", "Hư hỏng"
  createdAt     DateTime @default(now())

  @@index([ingredientId])
  @@index([createdAt])
}

// CASHBOOK / FINANCIAL MANAGEMENT

enum CashTransactionType {
  IN
  OUT
}

model CashTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        CashTransactionType
  amount      Float
  category    String   // e.g., "BÁN_HÀNG", "NHẬP_KHO", "LƯƠNG", "ĐIỆN_NƯỚC", "KHÁC"
  description String?
  referenceId String?  // Optional reference to OrderId, SessionId, or InventoryTransactionId
  
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([createdAt])
}

// SHIFT MANAGEMENT / CHẤM CÔNG

model Shift {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   // "Ca Sáng", "Ca Chiều", "Ca Tối"
  startTime   String   // "07:00"
  endTime     String   // "15:00"
  hourlyWage  Float    // Mức lương theo giờ
  isActive    Boolean  @default(true)
  
  records     ShiftRecord[]
}

model ShiftRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  shiftId     String   @db.ObjectId
  shift       Shift    @relation(fields: [shiftId], references: [id])
  
  checkIn     DateTime
  checkOut    DateTime?
  totalHours  Float?
  totalSalary Float?
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt   DateTime @default(now())
}
